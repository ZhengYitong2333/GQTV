<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/direction" style="@style/TvKey" android:text="@string/key_horizontal" />
    <TextView android:id="@+id/move" style="@style/TvKeyCaption" android:text="@string/key_browse" />
    <TextView style="@style/TvKey" android:layout_marginStart="10dp" android:text="@string/key_ok" />
    <TextView android:id="@+id/confirm" style="@style/TvKeyCaption" android:text="@string/key_tune" />
    <TextView style="@style/TvKey" android:layout_marginStart="10dp" android:text="@string/key_return_arrow" />
    <TextView android:id="@+id/back" style="@style/TvKeyCaption" android:text="@string/key_close" />
</LinearLayout>
