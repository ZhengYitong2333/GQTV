<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#F6C445" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="#33F6C445" />
            <stroke android:width="0.5dp" android:color="#B3F6C445" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#22E1ECF6" />
            <stroke android:width="0.5dp" android:color="#5CE1ECF6" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
